<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Watchman Catholic Charismatic Renewal Movement</title>
  <style>
    :root {
      --navy-dark: #071326;
      --navy-mid: #0d2142;
      --navy-light: #163363;
      --gold: #f5b82e;
      --gold-soft: #ffe08a;
      --sky-blue: #1e90ff;
      --bg-light: #f3f6fb;
      --card-bg: #ffffff;
      --text-main: #102038;
      --text-muted: #526480;
      --border-light: #dce4f0;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      background-color: var(--bg-light);
      color: var(--text-main);
      line-height: 1.6;
    }

    /* ================= HEADER & MORPHING LOGO ================= */
    header {
      background: linear-gradient(160deg, var(--navy-dark) 0%, var(--navy-mid) 100%);
      color: #ffffff;
      padding: 1.5rem 1rem 1rem;
      text-align: center;
      position: sticky;
      top: 0;
      z-index: 1000;
      box-shadow: 0 4px 18px rgba(0, 0, 0, 0.28);
      border-bottom: 2px solid rgba(245, 184, 46, 0.35);
    }

    .brand-top {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.85rem;
      max-width: 1100px;
      margin: 0 auto;
    }

    /* Box Logo that turns around randomly and changes shapes */
    .logo-morph-box {
      width: 96px;
      height: 96px;
      background: #ffffff;
      padding: 6px;
      border: 3px solid var(--gold);
      box-shadow: 0 0 22px rgba(30, 144, 255, 0.55);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      animation: morphAndTurn 10s ease-in-out infinite;
    }

    .logo-morph-box img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
    }

    @keyframes morphAndTurn {
      0% {
        border-radius: 14px;
        transform: rotate(0deg) scale(1);
        border-color: var(--gold);
      }
      20% {
        border-radius: 32px 8px 32px 8px;
        transform: rotate(14deg) scale(1.04);
        border-color: #38bdf8;
      }
      40% {
        border-radius: 8px 36px 12px 36px;
        transform: rotate(-18deg) scale(0.98);
        border-color: var(--gold);
      }
      60% {
        border-radius: 26px 26px 6px 6px;
        transform: rotate(360deg) scale(1.03);
        border-color: #38bdf8;
      }
      80% {
        border-radius: 6px 28px 6px 28px;
        transform: rotate(348deg) scale(1);
        border-color: var(--gold);
      }
      100% {
        border-radius: 14px;
        transform: rotate(360deg) scale(1);
        border-color: var(--gold);
      }
    }

    .brand-titles h1 {
      font-size: clamp(1.1rem, 3.8vw, 1.65rem);
      font-weight: 800;
      letter-spacing: 0.6px;
      line-height: 1.25;
      color: #ffffff;
    }

    .scripture-tag {
      display: inline-block;
      margin-top: 0.3rem;
      font-size: 0.88rem;
      font-weight: 700;
      color: var(--gold);
      letter-spacing: 0.5px;
    }

    /* Clean Responsive Navigation */
    nav {
      margin-top: 1rem;
      border-top: 1px solid rgba(255, 255, 255, 0.12);
      padding-top: 0.75rem;
    }

    .nav-links {
      list-style: none;
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 0.5rem 1.25rem;
    }

    .nav-links a {
      color: #e2ecff;
      text-decoration: none;
      font-size: 0.92rem;
      font-weight: 600;
      padding: 0.35rem 0.65rem;
      border-radius: 6px;
      transition: all 0.2s ease;
    }

    .nav-links a:hover,
    .nav-links a.active {
      color: var(--navy-dark);
      background-color: var(--gold);
    }

    /* ================= VISION HERO SECTION ================= */
    .vision-banner {
      background: linear-gradient(135deg, var(--navy-mid), var(--navy-light));
      color: #ffffff;
      padding: 2.25rem 1.25rem;
      text-align: center;
      border-bottom: 4px solid var(--gold);
    }

    .vision-inner {
      max-width: 820px;
      margin: 0 auto;
    }

    .vision-badge {
      display: inline-block;
      background: rgba(245, 184, 46, 0.18);
      color: var(--gold-soft);
      border: 1px solid rgba(245, 184, 46, 0.45);
      padding: 0.25rem 0.85rem;
      border-radius: 999px;
      font-size: 0.78rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 0.75rem;
    }

    .vision-inner blockquote {
      font-size: clamp(1.15rem, 3.2vw, 1.55rem);
      font-weight: 700;
      line-height: 1.45;
      color: #ffffff;
    }

    .vision-inner blockquote span {
      color: var(--gold);
    }

    /* ================= MAIN CONTAINER & SECTIONS ================= */
    main {
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem 1rem 3.5rem;
    }

    section {
      margin-bottom: 3.5rem;
      scroll-margin-top: 195px;
    }

    .section-header {
      text-align: center;
      margin-bottom: 1.5rem;
    }

    .section-header h2 {
      font-size: 1.65rem;
      color: var(--navy-dark);
      font-weight: 800;
    }

    .section-header p {
      color: var(--text-muted);
      font-size: 0.96rem;
      margin-top: 0.25rem;
    }

    .search-bar-wrap {
      max-width: 520px;
      margin: 0 auto 1.75rem;
    }

    .search-input {
      width: 100%;
      padding: 0.8rem 1.1rem;
      border: 2px solid var(--border-light);
      border-radius: 10px;
      font-size: 0.98rem;
      background: #ffffff;
      color: var(--text-main);
      outline: none;
      transition: border-color 0.2s;
    }

    .search-input:focus {
      border-color: var(--navy-light);
    }

    /* ================= ALPHABETICAL GALLERY GRID ================= */
    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 1.35rem;
    }

    .gallery-card {
      background: var(--card-bg);
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid var(--border-light);
      box-shadow: 0 4px 12px rgba(10, 25, 47, 0.06);
      display: flex;
      flex-direction: column;
      transition: transform 0.22s ease, box-shadow 0.22s ease;
      cursor: pointer;
    }

    .gallery-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 10px 24px rgba(10, 25, 47, 0.14);
    }

    .gallery-img-wrap {
      width: 100%;
      aspect-ratio: 4 / 3;
      background: #e5ecf6;
      overflow: hidden;
      position: relative;
    }

    .gallery-img-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top center;
      display: block;
      transition: transform 0.3s ease;
    }

    .gallery-card:hover .gallery-img-wrap img {
      transform: scale(1.04);
    }

    .gallery-caption {
      padding: 0.9rem 1rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      background: #ffffff;
    }

    .gallery-caption h3 {
      font-size: 0.98rem;
      font-weight: 700;
      color: var(--navy-dark);
      text-transform: capitalize;
    }

    .alpha-badge {
      background: var(--navy-mid);
      color: var(--gold);
      font-size: 0.72rem;
      font-weight: 800;
      padding: 0.2rem 0.5rem;
      border-radius: 5px;
      flex-shrink: 0;
    }

    /* ================= GPS LOCATOR & DIOCESE DIRECTORY ================= */
    .gps-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 1.15rem;
    }

    .diocese-card {
      background: #ffffff;
      border-radius: 12px;
      padding: 1.2rem;
      border: 1px solid var(--border-light);
      border-left: 5px solid var(--navy-mid);
      box-shadow: 0 3px 10px rgba(10, 25, 47, 0.05);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 0.85rem;
    }

    .diocese-card h3 {
      color: var(--navy-dark);
      font-size: 1.08rem;
      font-weight: 800;
      margin-bottom: 0.35rem;
    }

    .diocese-address {
      font-size: 0.92rem;
      color: var(--text-main);
      margin-bottom: 0.45rem;
    }

    .diocese-contact {
      font-size: 0.88rem;
      color: var(--text-muted);
      font-weight: 600;
    }

    .diocese-actions {
      display: flex;
      gap: 0.6rem;
      flex-wrap: wrap;
      margin-top: 0.3rem;
    }

    .btn-map,
    .btn-call {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.5rem 0.85rem;
      border-radius: 7px;
      font-size: 0.84rem;
      font-weight: 700;
      text-decoration: none;
      transition: opacity 0.2s;
    }

    .btn-map {
      background: var(--navy-mid);
      color: #ffffff;
    }

    .btn-call {
      background: #e8f0fe;
      color: var(--navy-mid);
      border: 1px solid #c5d8fa;
    }

    .btn-map:hover,
    .btn-call:hover {
      opacity: 0.88;
    }

    /* ================= ASK A QUESTION & CONTACTS ================= */
    .two-col-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 1.5rem;
    }

    .panel-box {
      background: #ffffff;
      border-radius: 12px;
      padding: 1.5rem;
      border: 1px solid var(--border-light);
      box-shadow: 0 4px 14px rgba(10, 25, 47, 0.06);
    }

    .panel-box h3 {
      font-size: 1.25rem;
      color: var(--navy-dark);
      margin-bottom: 0.5rem;
    }

    .form-group {
      margin-bottom: 1rem;
    }

    .form-group label {
      display: block;
      font-size: 0.88rem;
      font-weight: 700;
      margin-bottom: 0.35rem;
      color: var(--navy-dark);
    }

    .form-group input,
    .form-group textarea {
      width: 100%;
      padding: 0.72rem 0.9rem;
      border: 1.5px solid var(--border-light);
      border-radius: 8px;
      font-family: inherit;
      font-size: 0.95rem;
    }

    .btn-submit {
      width: 100%;
      padding: 0.85rem;
      background: var(--navy-dark);
      color: var(--gold);
      border: none;
      border-radius: 8px;
      font-size: 1rem;
      font-weight: 800;
      cursor: pointer;
    }

    .btn-submit:hover {
      background: var(--navy-light);
    }

    .contact-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
      margin-top: 0.75rem;
    }

    .contact-list li {
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--border-light);
      font-size: 0.94rem;
    }

    /* ================= LIGHTBOX MODAL ================= */
    .lightbox {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(5, 12, 24, 0.92);
      z-index: 2000;
      align-items: center;
      justify-content: center;
      padding: 1rem;
    }

    .lightbox.open {
      display: flex;
    }

    .lightbox-content {
      max-width: 900px;
      width: 100%;
      text-align: center;
      position: relative;
    }

    .lightbox-content img {
      max-height: 78vh;
      max-width: 100%;
      border-radius: 10px;
      border: 2px solid var(--gold);
    }

    .lightbox-title {
      color: #ffffff;
      font-size: 1.1rem;
      font-weight: 700;
      margin-top: 0.75rem;
    }

    .lightbox-close {
      position: absolute;
      top: -42px;
      right: 0;
      background: var(--gold);
      color: var(--navy-dark);
      border: none;
      border-radius: 6px;
      padding: 0.35rem 0.8rem;
      font-weight: 800;
      cursor: pointer;
    }

    /* ================= FOOTER ================= */
    footer {
      background: var(--navy-dark);
      color: #ffffff;
      text-align: center;
      padding: 2.25rem 1rem;
      border-top: 4px solid var(--gold);
    }

    .footer-remark {
      font-size: clamp(1.15rem, 3vw, 1.45rem);
      font-weight: 800;
      color: var(--gold);
      margin-bottom: 0.5rem;
    }

    .footer-sub {
      font-size: 0.88rem;
      color: #b8c7e0;
    }
  </style>
</head>
