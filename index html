          </p>
          <form onsubmit="submitQuestion(event)">
            <div class="form-group">
              <label for="qName">Your Full Name</label>
              <input type="text" id="qName" required placeholder="Enter your name" />
            </div>
            <div class="form-group">
              <label for="qLocation">City / State</label>
              <input type="text" id="qLocation" required placeholder="e.g., Abuja, Lagos, Port Harcourt" />
            </div>
            <div class="form-group">
              <label for="qMessage">Your Question or Prayer Request</label>
              <textarea id="qMessage" rows="4" required placeholder="Write your message here..."></textarea>
            </div>
            <button type="submit" class="btn-submit">Send via WhatsApp</button>
          </form>
        </div>

